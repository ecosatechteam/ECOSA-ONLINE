# Copy this file to .env and replace the placeholder secrets before deployment.
MONGODB_URI=mongodb://127.0.0.1:27017/ecosa
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password
PUBLIC_APP_URL=http://localhost:5173
FLUTTERWAVE_SECRET_KEY=replace-with-flutterwave-secret-key
FLUTTERWAVE_WEBHOOK_SECRET=replace-with-flutterwave-webhook-secret
FLUTTERWAVE_REDIRECT_URL=http://localhost:5173/payments
